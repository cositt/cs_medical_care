<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cs_medical_prn_rescue_view_list" model="ir.ui.view">
            <field name="name">cs.medical.prn.rescue.list</field>
            <field name="model">cs.medical.prn.rescue</field>
            <field name="arch" type="xml">
                <list string="Rescates PRN" decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="rescue_datetime"/>
                    <field name="resident_id"/>
                    <field name="medication_name"/>
                    <field name="dose"/>
                    <field name="route"/>
                    <field name="professional_id"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="cs_medical_prn_rescue_view_form" model="ir.ui.view">
            <field name="name">cs.medical.prn.rescue.form</field>
            <field name="model">cs.medical.prn.rescue</field>
            <field name="arch" type="xml">
                <form string="Rescate PRN farmacológico">
                    <header>
                        <button name="action_confirm" string="Confirmar registro" type="object"
                                class="oe_highlight" invisible="state == 'done'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Residente">
                                <field name="resident_id"/>
                                <field name="rescue_datetime"/>
                                <field name="professional_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Medicamento">
                                <field name="medication_name"/>
                                <field name="dose"/>
                                <field name="route"/>
                            </group>
                        </group>
                        <group string="Motivo PRN">
                            <field name="reason" nolabel="1"/>
                        </group>
                        <group string="Efecto observado">
                            <field name="effect_observed" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="cs_medical_prn_rescue_view_search" model="ir.ui.view">
            <field name="name">cs.medical.prn.rescue.search</field>
            <field name="model">cs.medical.prn.rescue</field>
            <field name="arch" type="xml">
                <search string="Rescates PRN">
                    <field name="name"/>
                    <field name="resident_id"/>
                    <field name="medication_name"/>
                    <field name="professional_id"/>
                    <separator/>
                    <filter name="filter_done" string="Confirmados" domain="[('state', '=', 'done')]"/>
                    <filter name="filter_draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
                    <separator/>
                    <filter name="group_resident" string="Agrupar: residente" context="{'group_by': 'resident_id'}"/>
                    <filter name="group_date" string="Agrupar: fecha" context="{'group_by': 'rescue_datetime:month'}"/>
                </search>
            </field>
        </record>

        <record id="cs_medical_prn_rescue_action" model="ir.actions.act_window">
            <field name="name">Rescates PRN</field>
            <field name="res_model">cs.medical.prn.rescue</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registre los rescates PRN farmacológicos de monitoras.
                </p>
            </field>
        </record>

        <menuitem id="cs_menu_medical_prn_rescue"
                  parent="cs_medical_care.cs_menu_medical"
                  name="Rescates PRN (monitoras)"
                  action="cs_medical_prn_rescue_action"
                  sequence="30"/>
    </data>
</odoo>
